generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GESTOR
  PROFESSOR
}

/*
  StudentPackageStatus - Explicado

  ACTIVE -> válido e com créditos
  EXPIRED -> Passou da validade
  DEPLETED -> créditos esgotados
  CANCELLED -> cancelado manulmente
*/

enum StudentPackageStatus {
  ACTIVE 
  EXPIRED 
  DEPLETED 
  CANCELLED 
} 

/*
  AppointementStatus - Explicado

  BOOKED -> marcado sem confirmação
  CONFIRMED -> confirmado presença
  RESCHEDULED -> remarcado
  CANCELLED -> Cancelado
*/

enum AppointmentStatus {
  BOOKED 
  CONFIRMED 
  RESCHEDULED 
  CANCELLED 
}

/*
  AttendanceStatus - Explicado

  PENDING -> aula ainda não aconteceu / presença não registrada
  PRESENT -> compareceu 
  ABSENT -> faltou (registrado manulmente)
  NO_SHOW -> faltou sem avisar (automação futura)
*/ 

enum AttendanceStatus {
  PENDING 
  PRESENT 
  ABSENT 
  NO_SHOW 
}

enum ClassSessionStatus {
  OPEN
  CANCELLED
  COMPLETED
}

model Academy {
  id String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  users User[]
  students Student[]
  professors Professor[]
  classSessions ClassSession[]
  appointments Appointment[]
  plans Plan[]
  studentPackages StudentPackage[]
  jobs Job[]
  whatsappPhoneNumberId String? @unique
  conversations Conversation[]
  cancelWindowHours Int @default(4) // prazo de cancelamento = momento do débito
  classTemplates ClassTemplate[]
  scheduleSlots ScheduleSlot[]
  recurrences Recurrence[]
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(PROFESSOR)
  academyId String
  
  active Boolean @default(true)

  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  sessions Session[]
  professor Professor?
}

model Session {
  id String @id @default(uuid())
  userId String
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id String @id @default(uuid())
  name String
  phone String
  cpf String
  email String?
  birthDate DateTime?
  academyId String

  active Boolean @default(true)
  registredAt DateTime @default(now())

  heightCm Int?
  weightKg Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  
  appointments Appointment[]
  studentPackages StudentPackage[]
  conversations Conversation[]
  recurrences Recurrence[]

  // CPF único POR academia
  @@unique([academyId, cpf])
}

model Professor {
  id String @id @default(uuid())
  name String
  phone String
  cpf String 
  academyId String
  userId String? @unique  // Conta de login vinculada (role PROFESSOR)

  active Boolean @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id])
  
  classSession ClassSession[]
  scheduleSlots ScheduleSlot[]

  @@unique([academyId, cpf])
}

model Plan {
  id String @id @default(uuid())
  academyId String
  name String
  credits Int //quantidade de aulas
  validityDays Int // validade em dias a partir da ativação
  price Decimal
  active Boolean @default(true)

  isTrial Boolean @default(false) // marca plano de aula experimentaç (1x por aluno)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  studentPackages StudentPackage[]

  @@unique([academyId, name]) // não repetir nome de plano na mesma academia
}

model StudentPackage{
  id String @id @default(uuid())
  academyId String
  studentId String
  planId String

  creditsTotal Int // quantidade comprada
  creditsRemaining Int // contador que diminui a cada agendamento
  startedAt DateTime @default(now())
  expiresAt DateTime //calculado no service
  status StudentPackageStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  @@index([academyId, studentId])
}

model ClassSession {
  id String @id @default(uuid())
  academyId String
  professorId String
  name String
  startAt DateTime
  capacity Int
  status ClassSessionStatus @default(OPEN)

  durationMin Int @default(60) // duração da aula
  minCapacity Int @default(3) // Minimo para aula acontecer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateId String?
  scheduleSlotId String? // preenchido quando a aula foi gerada pela grade

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  template ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduleSlot ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  
  @@unique([academyId, startAt]) //Evita duas aulas no mesmo horario
}

model Appointment {
  id String @id @default(uuid())
  academyId String
  studentId String
  classSessionId String
  studentPackageId String? // Qual pacote o crédito saiu

  status AppointmentStatus @default(BOOKED)
  attendance AttendanceStatus @default(PENDING) // Eixo de presença
  
  confirmedAt DateTime?
  confirmationSentAt DateTime?  
  cancelledAt DateTime?
  rescheduledAt DateTime?
  rescheduleFromId String?
  checkedInAt DateTime? 
  checkedInById String? // ID de quem registrou 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurrenceId String?
  debitedAt DateTime? // quando o credito saiu; null = reserva ainda não debitada
  cancelReason CancelReason?

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  studentPackage StudentPackage? @relation(fields: [studentPackageId], references: [id], onDelete: SetNull)
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  // Regras de estrutura
  @@index([classSessionId, studentId])
  @@index([academyId, classSessionId])
  @@index([academyId, studentId])
}

/*
  JobType - Tipo de trabalho à ser executado

  PRESENCE_CONFIRMATION -> disparo para confirmação de presença 12h antes da aula
  WELCOME -> Resposta para aluno novo/interessado entrou em contato
  PLAN_EXPIRY -> Plano atual do aluno está proximo do fim
*/

enum JobType {
  PRESENCE_CONFIRMATION
  WELCOME
  PLAN_EXPIRY
}

/*
  JobStatus - Estado atual do trabalho

  PENDING -> Aguardando hora para ser executado
  PROCESSING -> Worker pegou, evita duplicidade de evento
  SENT -> Enviado com sucesso
  FAILED -> Falha no envio, debugar erro (lastError)
*/

enum JobStatus { 
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Job{
  id String @id @default(uuid())
  academyId String 
  type JobType
  status JobStatus @default(PENDING)
  relatedId String? 
  payload Json 
  scheduledFor DateTime @default(now())
  attempts Int @default(0)
  maxAttempts Int @default(3)
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)

  @@index([status, scheduledFor]) // Para o worker buscar toda hora
}

// Estado atual do agendamento do aluno
enum AppointmentEventType{
  BOOKED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  PRESENT
  ABSENT
  NO_SHOW
  DEBITED
}

// Tipo do autor que "atualizou" no agendamento
enum ActorType{
  STUDENT
  STAFF
  SYSTEM
}

// Log do agendamento - A verdade sobre o agendamento
model AppointmentEvent{
  id String @id @default(uuid())
  academyId String
  appointmentId String
  classSessionId String
  studentId String

  type AppointmentEventType
  actorType ActorType
  actorId String? //userId (academia), studentId (aluno), null (sistema-worker)

  creditRefunded Boolean? 
  note String? 

  createdAt DateTime @default(now())
  
  // Log desaclopado: guarda os ID (sem relatio) - append-only
  @@index([academyId, studentId, createdAt])
  @@index([classSessionId])
  @@index([appointmentId])
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  RECEIVED //mensagem de entrada
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id String @id @default(uuid())
  academyId String
  waId String // Contato canonico devlvido pela Meta (chave da conersa)
  contactName String? // Nome do perfil do whatsapp
  studentId String? // Vinculo com aluno, quando telefone bate

  lastInboundAt DateTime? // Ultima mensagem do contato -> base da janela de 24h
  lastMessageAt DateTime? // Ordena a lista de conversa 
  unreadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([academyId, waId])
  @@index([academyId, lastMessageAt])
}

model Message {
  id String @id @default(uuid())
  conversationId String
  direction MessageDirection
  type String //"text", "button", "template", "image"... (tipo cru da Meta)
  text String?
  waMessageId String? @unique // id da meta: ignora webhook repetido + atualiza status
  status MessageStatus
  sentById String?  // userId de quam respondeu pelo chat; null = aluno ou automação.

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum CancelReason {
  STUDENT // aluno cancelou = "pular": a recorrência NÃO reserva essa data de novo
  STAFF // academia cancelou a reserva
  CLASS_CANCELLED // a aula inteira foi cancelada
  CREDIT_USED // crédito usado em outra aula (o aluno escolheu)
  NO_CREDIT // sem cobertura (24h antes ou no prazo)
  RECURRENCE_CHANGED // o horario saiu da recorrencia do aluno
}

model ClassTemplate{
  id String @id @default(uuid())
  academyId String
  name String
  durationMin Int @default(50)
  capacity Int
  minCapacity Int @default(3)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  slots ScheduleSlot[]
  classSessions ClassSession[]

  @@unique([academyId, name])
}

model ScheduleSlot {
  id String @id @default(uuid())
  academyId String
  weekday Int // 0 - Domingo ... 6 - sabado (igual ao getDay do JS)
  time String // 7:00, no horario da academia
  professorId String
  templateId String
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Restrict)
  template ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  classSessions ClassSession[]
  recurrences Recurrence[]

  @@unique([academyId, weekday, time])
}

model Recurrence {
  id String @id @default(uuid())
  academyId String 
  studentId String
  scheduleSlotId String
  active Boolean @default(true)
  createdById String? // userId se a academia configurou; null = o proprio aluno

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([studentId, scheduleSlotId])
}
