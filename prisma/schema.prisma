generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GESTOR
  PROFESSOR
}

/*
  StudentPackageStatus - Explicado

  ACTIVE -> válido e com créditos
  EXPIRED -> Passou da validade
  DEPLETED -> créditos esgotados
  CANCELLED -> cancelado manulmente
*/

enum StudentPackageStatus {
  ACTIVE 
  EXPIRED 
  DEPLETED 
  CANCELLED 
} 

/*
  AppointementStatus - Explicado

  BOOKED -> marcado sem confirmação
  CONFIRMED -> confirmado presença
  RESCHEDULED -> remarcado
  CANCELLED -> Cancelado
*/

enum AppointmentStatus {
  BOOKED 
  CONFIRMED 
  RESCHEDULED 
  CANCELLED 
}

/*
  AttendanceStatus - Explicado

  PENDING -> aula ainda não aconteceu / presença não registrada
  PRESENT -> compareceu 
  ABSENT -> faltou (registrado manulmente)
  NO_SHOW -> faltou sem avisar (automação futura)
*/ 

enum AttendanceStatus {
  PENDING 
  PRESENT 
  ABSENT 
  NO_SHOW 
}

enum ClassSessionStatus {
  OPEN
  CANCELLED
  COMPLETED
}

model Academy {
  id String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  users User[]
  students Student[]
  professors Professor[]
  classSessions ClassSession[]
  appointments Appointment[]
  plans Plan[]
  studentPackages StudentPackage[]
  jobs Job[]
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(PROFESSOR)
  academyId String
  
  active Boolean @default(true)

  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  sessions Session[]
  professor Professor?
}

model Session {
  id String @id @default(uuid())
  userId String
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id String @id @default(uuid())
  name String
  phone String
  cpf String
  email String?
  birthDate DateTime?
  academyId String

  active Boolean @default(true)
  registredAt DateTime @default(now())

  heightCm Int?
  weightKg Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])
  appointments Appointment[]
  studentPackages StudentPackage[]

  // CPF único POR academia
  @@unique([academyId, cpf])
}

model Professor {
  id String @id @default(uuid())
  name String
  phone String
  cpf String 
  academyId String
  userId String? @unique  // Conta de login vinculada (role PROFESSOR)

  active Boolean @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id])
  classSession ClassSession[]

  @@unique([academyId, cpf])
}

model Plan {
  id String @id @default(uuid())
  academyId String
  name String
  credits Int //quantidade de aulas
  validityDays Int // validade em dias a partir da ativação
  price Decimal
  active Boolean @default(true)

  isTrial Boolean @default(false) // marca plano de aula experimentaç (1x por aluno)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  studentPackages StudentPackage[]

  @@unique([academyId, name]) // não repetir nome de plano na mesma academia
}

model StudentPackage{
  id String @id @default(uuid())
  academyId String
  studentId String
  planId String

  creditsTotal Int // quantidade comprada
  creditsRemaining Int // contador que diminui a cada agendamento
  startedAt DateTime @default(now())
  expiresAt DateTime //calculado no service
  status StudentPackageStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  @@index([academyId, studentId])
}

model ClassSession {
  id String @id @default(uuid())
  academyId String
  professorId String
  name String
  startAt DateTime
  capacity Int
  status ClassSessionStatus @default(OPEN)

  durationMin Int @default(60) // duração da aula
  minCapacity Int @default(3) // Minimo para aula acontecer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([academyId, startAt]) //Evita duas aulas no mesmo horario
}

model Appointment {
  id String @id @default(uuid())
  academyId String
  studentId String
  classSessionId String
  studentPackageId String? // Qual pacote o crédito saiu

  status AppointmentStatus @default(BOOKED)
  attendance AttendanceStatus @default(PENDING) // Eixo de presença
  
  confirmedAt DateTime?
  cancelledAt DateTime?
  rescheduledAt DateTime?
  rescheduleFromId String?
  checkedInAt DateTime? 
  checkedInById String? // ID de quem registrou 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  studentPackage StudentPackage? @relation(fields: [studentPackageId], references: [id], onDelete: SetNull)

  // Regras de estrutura
  @@index([classSessionId, studentId])
  @@index([academyId, classSessionId])
  @@index([academyId, studentId])
}

/*
  JobType - Tipo de trabalho à ser executado

  PRESENCE_CONFIRMATION -> disparo para confirmação de presença 12h antes da aula
  WELCOME -> Resposta para aluno novo/interessado entrou em contato
  PLAN_EXPIRY -> Plano atual do aluno está proximo do fim
*/

enum JobType {
  PRESENCE_CONFIRMATION
  WELCOME
  PLAN_EXPIRY
}

/*
  JobStatus - Estado atual do trabalho

  PENDING -> Aguardando hora para ser executado
  PROCESSING -> Worker pegou, evita duplicidade de evento
  SENT -> Enviado com sucesso
  FAILED -> Falha no envio, debugar erro (lastError)
*/

enum JobStatus { 
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Job{
  id String @id @default(uuid())
  academyId String 
  type JobType
  status JobStatus @default(PENDING)
  relatedId String? 
  payload Json 
  scheduledFor DateTime @default(now())
  attempts Int @default(0)
  maxAttempts Int @default(3)
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)

  @@index([status, scheduledFor]) // Para o worker buscar toda hora
}